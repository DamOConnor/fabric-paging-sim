      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "fabric-paging-sim",
      "metadata": {
        "description": "Base name used to derive resource names"
      }
    },
