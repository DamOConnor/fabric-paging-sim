      "type": "string",
      "defaultValue": "Standard_LRS",
      "metadata": {
        "description": "Storage account SKU"
      }
    }
  },
  "variables": {
    "rawStorageName": "[toLower(replace(replace(resourceGroup().name, '-', ''), ' ', ''))]",
    "storageNameSuffix": "[uniqueString(resourceGroup().id)]",
    "truncatedStorageName": "[take(format('{0}{1}', variables('rawStorageName'), variables('storageNameSuffix')), 24)]",
    "planName": "[format('{0}-plan', parameters('appName'))]",
    "uamiName": "[format('{0}-uami', parameters('appName'))]",
